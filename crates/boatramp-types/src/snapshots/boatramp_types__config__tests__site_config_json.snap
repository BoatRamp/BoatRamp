{
  "version": 1,
  "domains": {
    "primary": null,
    "aliases": [],
    "wildcards": [],
    "canonical_redirect": false
  },
  "security": {
    "https_redirect": false
  },
  "access": {
    "ip": {
      "allow": [],
      "deny": []
    },
    "trusted_proxies": []
  },
