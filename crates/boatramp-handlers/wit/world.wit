// boatramp host bindings. Each capability the handler engine offers a guest is
// a standard WASI interface, vendored under `deps/` and pinned deliberately
// (standard interfaces only). bindgen! generates the
// host side per world; the implementations live in `src/bindings/`.
//
// The package is deliberately UNVERSIONED. A WIT package version is a component-model
// *linking* identity, not a capability advertisement: versioning it broke every existing
// (unversioned) consumer guest — the host's export lookup for `messaging-handler` became
// version-strict and no longer matched an unversioned guest export, and the deploy resolver
// could not reconcile an unversioned guest import against a versioned host package. So the
// contract stays unversioned and evolves APPEND-ONLY (new cases are additive; a genuinely
// breaking change would be a new interface, served in coexistence). Capability *availability*
// ("does this host implement the feature I need?") is answered separately — by a version-ranged
// `requires` in the guest's function-manifest, checked at deploy — never by this package's
// version. See `PLAN-capability-contract-versioning-v2` + `boatramp capabilities`.
package boatramp:handlers;

/// The key/value capability: `wasi:keyvalue` store + atomics + batch, backed by
/// boatramp's `KvStore` with a per-site key prefix.
world keyvalue-host {
  include wasi:keyvalue/imports@0.2.0-draft;
}

/// The blob capability: `wasi:blobstore`, backed by boatramp's `Storage` with a
/// per-site container prefix (`hblob/{site}/`).
world blobstore-host {
  include wasi:blobstore/imports@0.2.0-draft;
}

/// Value types for the `sql` capability. Kept deliberately small and
/// engine-agnostic (a wasi:sql-shaped vocabulary); richer SQL
/// types are surfaced to the guest as `text`.
interface sql-types {
  /// A bound parameter or returned cell.
  variant value {
    null,
    boolean(bool),
    integer(s64),
    %float(f64),
    text(string),
    blob(list<u8>),
    /// A JSON document (the JSON text). The host binds it with the right column
    /// type per engine (`jsonb`/`json` on Postgres, JSON string on MySQL, text on
    /// SQLite) — so a guest can write a `jsonb` column without a `::jsonb` cast.
    json(string),
  }

  /// One result row, column order matching `query-result.columns`.
  record row {
    values: list<value>,
  }

  /// The rows a `query` returned.
  record query-result {
    columns: list<string>,
    rows: list<row>,
  }

  /// Why a statement failed.
  variant error {
    /// The statement could not be parsed/planned.
    syntax(string),
    /// A constraint (unique, type, ...) was violated.
    constraint(string),
    /// Any other backend error.
    other(string),
  }
}

/// The `sql` capability. A site may be bound several **named** databases (the
/// operator maps each name to a backend — possibly different engines, e.g. a
/// local `cache` and a shared `main`); `open` selects one. The host wraps each
/// invocation in one transaction *per opened database*, committing them on a
/// successful response and rolling them back on trap/error.
/// They are independent transactions — there is no cross-database atomicity.
interface sql-query {
  use sql-types.{value, query-result, error};

  /// A handle to one of the site's named databases.
  resource database {
    /// Run a row-returning statement (e.g. `SELECT`). Parameter placeholders
    /// use **numbered SQLite syntax** (`?1`, `?2`, …) on *every* backend — the
    /// host rewrites them to the engine's native form (Postgres `$N`, MySQL `?`)
    /// for an external database, so guest SQL stays portable. Writing native
    /// `$N` / `:name` is rejected. `params` bind positionally by number.
    query: func(statement: string, params: list<value>) -> result<query-result, error>;

    /// Run a non-row statement (`INSERT`/`UPDATE`/`DELETE`/DDL); `params` bind
    /// placeholders. Returns the number of affected rows (0 for DDL).
    execute: func(statement: string, params: list<value>) -> result<u64, error>;
  }

  /// Open one of the site's databases by the name the operator bound (the empty
  /// string is the default database). Fails if no database was granted under
  /// that name.
  open: func(name: string) -> result<database, error>;

  /// Open a database for **read-only** use. Where the operator has configured a
  /// read replica, the handle's transaction is routed to it (reads → replica,
  /// writes → primary), so read-heavy handlers can offload
  /// the primary. A replica may lag, so reads are eventually consistent;
  /// `execute` (a write) on this handle is rejected by the read endpoint. With
  /// no replica configured this behaves exactly like `open`.
  open-read-only: func(name: string) -> result<database, error>;
}

/// The sql capability world.
world sql-host {
  import sql-query;
}

/// A typed query interface — the host compiles it to injection-safe `?N` SQL and runs it
/// through the same per-invocation transaction as `sql-query` (so a handler may mix the two
/// on one database). Reuses `sql-types`. Covers the common shapes; anything it can't express
/// (correlated subqueries, DISTINCT ON, CTEs, JSON paths, …) stays on raw `sql-query`.
interface orm {
  use sql-types.{value, row, query-result, error};

  enum agg { count, sum, avg, min, max }
  enum bin-op { add, sub, mul, div, modulo }
  // (`lower`/`upper` are spelled `*-case` to avoid colliding with wasmtime's ComponentType
  // `Lower` associated item in the generated bindings.)
  enum scalar-func { lower-case, upper-case, length, trim, abs, round, coalesce, now }
  enum cmp-op { eq, ne, lt, le, gt, ge }
  enum join-kind { inner, left-join }
  enum direction { asc, desc }
  // `pgvector` distance metric (Postgres-only): cosine `<=>` / L2 `<->`.
  enum distance-metric { cosine, l2 }

  // ---- expression arena ----------------------------------------------------
  // Recursive scalar expressions cross the WIT boundary as a flat arena: an `expr-node`'s
  // children are indices into the query's `exprs` list. A child index is ALWAYS strictly
  // less than its parent's, so the arena is acyclic + bounds-checkable and the host rebuilds
  // the tree without trusting the guest (an out-of-range or forward index is rejected).
  record agg-node { agg: agg, arg: u32 }
  record binary-node { op: bin-op, left: u32, right: u32 }
  record call-node { which: scalar-func, args: list<u32> }
  record json-node { base: u32, path: list<string> }   // path keys => `$.a.b` / `#>>'{a,b}'`
  // `(exprs[left] <op> exprs[right])` per `metric`; Postgres-only (fails closed elsewhere).
  record distance-node { left: u32, right: u32, metric: distance-metric }
  // A correlated roll-up: `(SELECT agg(arg) FROM table WHERE preds[filter])`. `arg` is a column
  // name (`none` = `*`, count-only); `filter` indexes the `preds` arena and — like every arena
  // reference reachable from it — must stay strictly below this node so the whole thing is
  // acyclic. Only accepted when the host has the `orm-subquery` feature.
  record related-aggregate-node { agg: agg, arg: option<string>, table: string, filter: u32 }
  // A scalar subquery `(SELECT column FROM table WHERE preds[filter])`; `filter` strictly below.
  record related-scalar-node { column: string, table: string, filter: u32 }
  // `CASE WHEN preds[when] THEN exprs[then] … [ELSE exprs[otherwise]] END`. Each `when`/`then`/
  // `otherwise` indexes the pred/expr arena and must stay strictly below this node (acyclic).
  record case-branch { when: u32, then: u32 }
  record case-node { branches: list<case-branch>, otherwise: option<u32> }
  // A pair of expr indices (both strictly below the parent): used by the JSON dynamic-key
  // extract `(exprs[left] ->> exprs[right])` and jsonb concat `(exprs[left] || exprs[right])`.
  record json-pair { left: u32, right: u32 }
  variant expr-node {
    column(string),
    literal(value),
    star,                       // valid only as the count(*) argument
    aggregate(agg-node),
    binary(binary-node),
    call(call-node),
    json-extract(json-node),
    // Append-only: these cases are param-position (guest→host), so adding them is
    // backward-compatible — an old host simply never receives them, a new host accepts more. A
    // guest that emits them needs a host that implements them; that requirement is declared in
    // the guest's function-manifest `requires` and checked at deploy (not via a package version).
    distance(distance-node),
    vector-literal(string),     // a bracketed float list, bound + rendered `?N::vector`
    related-aggregate(related-aggregate-node),
    case-expr(case-node),
    json-extract-dyn(json-pair),   // (exprs[left] ->> exprs[right]); PG+SQLite, MySQL fails closed
    json-concat(json-pair),        // (exprs[left] || exprs[right]); Postgres-only
    related-scalar(related-scalar-node),
    // A host-resolved "is this row the caller's own tenant?" 0/1 rank — the guest never names the
    // (host-injected, hidden) tenant column. Lowered against the same resolved scope to
    // `CASE WHEN (<col> IS NOT NULL AND <col> = <own>) THEN 1 ELSE 0 END`; fails closed with no
    // own-tenant scope. For base-vs-override reads (`ORDER BY is_own DESC`). Needs host `orm-own-pref`.
    is-own,
  }

  // ---- predicate arena -----------------------------------------------------
  // Boolean predicates are a second arena. `conj`/`disj`/`negate` reference `preds` by index
  // (again strictly-lower => acyclic); the scalar fields reference `exprs`.
  record compare-node { left: u32, op: cmp-op, right: u32 }
  record between-node { expr: u32, low: u32, high: u32, negated: bool }
  record in-node { expr: u32, values: list<u32>, negated: bool }
  record like-node { expr: u32, pattern: string, insensitive: bool, negated: bool }
  // `exprs[expr] [NOT] IN (SELECT column FROM table WHERE preds[filter])` — narrow single-table
  // IN-subquery; `filter` indexes `preds` strictly below this node (acyclic). `orm-subquery`.
  record in-subquery-node { expr: u32, column: string, table: string, filter: u32, negated: bool }
  record null-node { expr: u32, negated: bool }
  variant pred-node {
    conj(list<u32>),            // AND
    disj(list<u32>),            // OR
    negate(u32),                // NOT
    compare(compare-node),
    between(between-node),
    within(in-node),            // IN
    matches(like-node),         // LIKE
    is-null(null-node),
    in-subquery(in-subquery-node),
  }

  record select-item { expr: u32, alias: option<string> }
  record order-term { expr: u32, dir: direction }
  /// `<kind> JOIN <table>[ AS <alias>] ON <preds[on]>`.
  record join { kind: join-kind, table: string, alias: option<string>, on: u32 }
  /// An optional in-site row-tenancy scope: `column = value` (conjoined on read/update,
  /// forced on insert). The project/database boundary is separate (the opened database).
  record scope { column: string, value: value }

  // A SELECT with no UNION — its own arena bundle. Used both as a top-level query body and as a
  // UNION branch / INSERT…SELECT source (WIT records can't self-reference, so `select-query`
  // can't hold a `select-query`; it holds this instead, one level deep).
  record select-body {
    exprs: list<expr-node>,
    preds: list<pred-node>,
    table: string,
    table-alias: option<string>,
    columns: list<select-item>,
    joins: list<join>,
    filter: option<u32>,
    scope: option<scope>,
    group-by: list<u32>,
    having: option<u32>,
    distinct: bool,
    distinct-on: list<u32>,
    order: list<order-term>,
    limit: option<u32>,
    offset: option<u32>,
  }
  // `<body> UNION [ALL] <branch>`. Each side carries its own scope, so both stay tenant-isolated.
  record union-arm { all: bool, body: select-body }
  record select-query {
    exprs: list<expr-node>,
    preds: list<pred-node>,
    table: string,
    table-alias: option<string>,
    columns: list<select-item>,   // empty => SELECT *
    joins: list<join>,
    filter: option<u32>,          // pred index
    scope: option<scope>,
    group-by: list<u32>,          // expr indices
    having: option<u32>,          // pred index
    distinct: bool,
    distinct-on: list<u32>,       // expr indices; DISTINCT ON (...), Postgres-only
    order: list<order-term>,
    limit: option<u32>,
    offset: option<u32>,
    union: option<union-arm>,
  }

  record assignment { column: string, value: u32 }   // value = expr index
  record row-values { cells: list<assignment> }
  /// ON CONFLICT (<conflict-columns>) DO UPDATE SET <update> (empty update => DO NOTHING).
  record on-conflict { conflict-columns: list<string>, update: list<assignment> }
  // `INSERT INTO t (columns) <source>` — the inserted rows come from a SELECT.
  record insert-select { columns: list<string>, source: select-body }
  record insert-query {
    exprs: list<expr-node>,       // insert has no predicates, only cell/upsert expressions
    table: string,
    rows: list<row-values>,
    conflict: option<on-conflict>,
    scope: option<scope>,
    returning: list<select-item>,
    select-source: option<insert-select>,
  }
  /// `filter` is required — an unbounded update is refused.
  record update-query {
    exprs: list<expr-node>,
    preds: list<pred-node>,
    table: string,
    set: list<assignment>,
    filter: u32,                  // pred index
    scope: option<scope>,
    returning: list<select-item>,
  }
  /// `filter` is required — an unbounded delete is refused (mirrors update-query, minus `set`).
  record delete-query {
    exprs: list<expr-node>,
    preds: list<pred-node>,
    table: string,
    filter: u32,                  // pred index
    scope: option<scope>,
    returning: list<select-item>,
  }
  /// attach-reference (5d): insert a row into `child` whose tenant is DERIVED from a `parent` row
  /// reachable under the caller's confined scope. `set` are the child's non-tenant columns; the
  /// tenant is projected from the scoped parent (the guest never names it). `ref-value` is a
  /// row-selector INSIDE the caller's scope (`parent.<ref-column> = ref-value`), an expr index.
  record attach-reference-query {
    exprs: list<expr-node>,       // the `set` values + the `ref-value`
    child: string,
    parent: string,
    ref-column: string,
    ref-value: u32,               // expr index of the ref selector value
    set: list<assignment>,
  }

  /// A handle to one of the site's named databases (same model as `sql-query`).
  resource database {
    select: func(q: select-query) -> result<query-result, error>;
    insert: func(q: insert-query) -> result<u64, error>;
    update: func(q: update-query) -> result<u64, error>;
    /// Affected-row count. Use `delete-returning` when the query has a RETURNING clause and the
    /// caller needs the deleted rows (consume-and-read).
    delete: func(q: delete-query) -> result<u64, error>;
    /// Run a DELETE and return its RETURNING rows (the `returning` list must be non-empty).
    delete-returning: func(q: delete-query) -> result<query-result, error>;
    /// promote (R3, PLAN-tenancy-principal D7): a returning visitor, now authenticated, CLAIMS
    /// their anonymous-session rows in `table` for their tenant. Host-mediated + deny-by-default:
    /// the host builds `UPDATE <table> SET <tenant-key> = <own> WHERE <session-key> = <session>
    /// AND <tenant-key> IS NULL` from the request's OWN resolved tenant + session facts (the guest
    /// names neither and cannot widen past its own not-yet-owned session rows). Requires `table` be
    /// a TenantOrSession table and BOTH facts present, else refused. Returns the rows claimed
    /// (idempotent: a second call claims 0). Append-only ABI addition — a pinned older guest that
    /// does not import it is unaffected.
    promote: func(table: string) -> result<u64, error>;
    /// attach-reference (R4/D8 5d): a host-mediated DERIVED-tenant write. Inserts a row into `child`
    /// stamping its tenant from a `parent` row reachable under the caller's current confined scope
    /// (`INSERT … SELECT parent.<tenant> … WHERE parent.<ref> = ? AND <caller scope>`), so the
    /// stamped tenant is bounded by the caller's own reach (adds no authority) and an unreachable
    /// parent is a fail-closed no-op (0 rows). Under a target scope the child's public-visibility
    /// columns are force-stamped and the `set` columns are gated by the write-allowlist; a read-only
    /// route (e.g. a `handle` source) has no write axis and is refused (G1). Append-only ABI
    /// addition — a pinned older guest that does not import it is unaffected.
    attach-reference: func(q: attach-reference-query) -> result<u64, error>;
  }

  open: func(name: string) -> result<database, error>;
}

/// The orm capability world.
world orm-host {
  import orm;
}

/// Value types for the `wasi:messaging`-shaped capability. Deliberately small:
/// a message is a topic + opaque bytes. Topics are
/// namespaced by the host per (site, alias) with preview isolation — a guest
/// only ever names topics relative to its own namespace.
interface messaging-types {
  /// A delivered message: the (guest-relative) topic and its payload.
  record message {
    topic: string,
    data: list<u8>,
  }

  /// Why a messaging operation failed.
  variant error {
    /// The capability was not granted to this handler.
    access-denied,
    /// Any other backend error.
    other(string),
  }
}

/// The producer half: publish a message to a topic. Imported by request
/// handlers and consumers alike (whatever the site grants `wasi:messaging`).
interface messaging-producer {
  use messaging-types.{error};

  /// Publish `data` to `topic` (host-namespaced). Returns once durably enqueued.
  publish: func(topic: string, data: list<u8>) -> result<_, error>;
}

/// The consumer half: the host calls `handle` once per delivered message. A
/// consumer component exports this; the dispatcher invokes it under the handler
/// limits regime, acking on `ok` and redelivering (eventually dead-lettering)
/// on `err`/trap.
interface messaging-handler {
  use messaging-types.{message, error};

  /// Process one message. `ok` acks; `err` (or a trap) triggers redelivery.
  handle: func(msg: message) -> result<_, error>;
}

/// The producer capability world (imported into request handlers).
world messaging-host {
  import messaging-producer;
}

/// A message-consumer component: it may publish, and it must handle deliveries.
world consumer {
  import messaging-producer;
  export messaging-handler;
}

/// Value types for the `invoke` capability: a small HTTP-shaped request/response
/// so one function can call another the same way the platform invokes it from
/// the outside (functions are `wasi:http` handlers, so the natural call shape is
/// an HTTP request/response). Bodies are buffered `list<u8>` — internal calls are
/// request/response, not streams.
interface invoke-types {
  /// One header: field name and its raw value bytes.
  record header {
    name: string,
    value: list<u8>,
  }

  /// A call to a sibling function. `path` is the request target the callee sees
  /// (path plus any query); `method`, `headers`, and `body` pass through verbatim.
  record invoke-request {
    method: string,
    path: string,
    headers: list<header>,
    body: list<u8>,
  }

  /// The callee's buffered response.
  record invoke-response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  /// Why an invoke failed.
  variant error {
    /// The `invoke` capability was not granted to this function.
    access-denied,
    /// The target is not permitted by this function's invoke allowlist. Carries
    /// the rejected target name.
    target-not-allowed(string),
    /// No function is registered under the target name. Carries the name.
    not-found(string),
    /// The maximum function-to-function call depth was exceeded (loop guard).
    loop-detected,
    /// The callee ran but failed (trap, timeout, overload, ...). Carries a reason.
    failed(string),
  }
}

/// The `invoke` capability: call another function in-process and get its
/// response, without leaving the sandbox for a network round-trip. The callable
/// targets are an operator-configured allowlist (each entry may use `*`
/// wildcards); the host caps call depth so functions cannot invoke in a loop.
interface invoke {
  use invoke-types.{header, invoke-request, invoke-response, error};

  /// A streamed response from a sibling function: `status` and `headers` are
  /// available immediately, and the body is pulled incrementally via `read`, so a
  /// large or incrementally-produced response is never buffered whole in host
  /// memory. Returned by `invoke-streaming`.
  resource incoming-response {
    /// The callee's HTTP status.
    status: func() -> u16;
    /// The callee's response headers.
    headers: func() -> list<header>;
    /// Read up to `max` more bytes of the body, blocking until at least one byte
    /// is available or the stream ends. An empty list marks end of stream.
    read: func(max: u64) -> result<list<u8>, error>;
  }

  /// Invoke the function named `target` with `request`, returning its response.
  invoke: func(target: string, request: invoke-request) -> result<invoke-response, error>;

  /// Like `invoke`, but the response body **streams**: the returned resource
  /// yields status + headers up front and the body incrementally via `read`, so
  /// the caller never buffers the whole body. The request body is still passed
  /// whole (request streaming is a separate future step).
  invoke-streaming: func(target: string, request: invoke-request) -> result<incoming-response, error>;
}

/// The invoke capability world (imported into request handlers / functions).
world invoke-host {
  import invoke;
}

/// Value types for the `graphql` capability: run an operation against the project's
/// composed federation supergraph in-process — the same planner + executor an external
/// `/graphql` request uses — so a guest can query the unified API (cross-subgraph
/// planning), without a network hop or egress surface.
interface graphql-types {
  /// A GraphQL operation to run against the supergraph. `variables` is a JSON object
  /// encoded as a string (`{}` when none); `operation-name` selects one of several
  /// operations in `query`; `authorization` forwards the caller's own raw `Authorization`
  /// header value (scheme included) so each subgraph's field guards see the guest's principal
  /// (re-verified per subgraph — the guest cannot escalate by running this).
  record graphql-request {
    query: string,
    variables: string,
    operation-name: option<string>,
    authorization: option<string>,
  }

  /// Why a supergraph run was refused.
  variant graphql-error {
    /// The `graphql` capability was not granted to this function.
    access-denied,
    /// The operation is not on the project's registered safelist. Guest-run operations
    /// are deny-by-default: only pre-registered operations run.
    not-safelisted,
    /// The query could not be planned against the supergraph. Carries a reason.
    plan-failed(string),
    /// The maximum in-process call depth was exceeded (loop guard) — shared with `invoke`,
    /// so a guest op → subgraph fetch → guest op chain cannot loop.
    depth-exceeded,
    /// The run failed (composition, execution, ...). Carries a reason.
    failed(string),
  }
}

/// The `graphql` capability: run a GraphQL operation against the project's composed
/// supergraph in-process — cross-subgraph planning + execution over the invoke path, no
/// network hop, no egress. Deny-by-default: only pre-registered (safelisted) operations
/// run, and the caller's own `Authorization` is forwarded and re-verified by each subgraph.
interface graphql {
  use graphql-types.{graphql-request, graphql-error};

  /// Run `request` against the supergraph; returns the GraphQL response JSON bytes
  /// (`{data, errors}`), the same result an external `/graphql` POST would produce.
  run: func(request: graphql-request) -> result<list<u8>, graphql-error>;

  /// Run a pre-registered operation by its safelist hash (sha256-hex of the query text),
  /// with `variables` (a JSON object string) and the caller's raw `authorization` header.
  run-persisted: func(hash: string, variables: string, authorization: option<string>) -> result<list<u8>, graphql-error>;
}

/// The graphql capability world (imported into request handlers / functions).
world graphql-host {
  import graphql;
}

/// Value types for the `email` capability: a first-class **per-project SMTP
/// gateway**. The guest hands the host a *finished* message — it renders its own
/// HTML/plaintext, boatramp does NO templating — and the host delivers it through
/// one of the project's operator-configured SMTP profiles, whose credentials the
/// guest never sees (host-held; the guest can only invoke the verb). `send` is
/// **accepted-for-delivery**: the host spools the message and delivers it
/// asynchronously (in-memory best-effort by default, or a durable persisted +
/// retried queue when `durable` is set).
interface email-types {
  /// One outbound message. At least one of `text`/`html` must be present.
  record email-message {
    /// Which of the project's SMTP profiles to send through; `none` = "default".
    profile: option<string>,
    /// Envelope recipients. `to` must be non-empty; `cc`/`bcc` may be empty.
    to: list<string>,
    cc: list<string>,
    bcc: list<string>,
    /// The `From` address. Must be permitted by the chosen profile (a guest can't
    /// spoof an arbitrary sender); `none` uses the profile's configured default.
    /// (`from` is a WIT keyword, so it is escaped `%from`; the field is `from`.)
    %from: option<string>,
    reply-to: option<string>,
    subject: string,
    /// The `text/plain` body.
    text: option<string>,
    /// The `text/html` body (guest-rendered; boatramp does no templating).
    html: option<string>,
    /// Opt into the durable spool (persisted + retried, survives a restart)
    /// instead of the default in-memory best-effort delivery; `none` = the
    /// profile's default.
    durable: option<bool>,
  }

  /// Why a send was refused.
  variant email-error {
    /// The `email` capability was not granted to this handler/function.
    access-denied,
    /// No SMTP profile is configured under the requested name. Carries the name.
    unknown-profile(string),
    /// The message was rejected before spooling (empty recipients/subject, no
    /// body, or a `from` the profile does not permit). Carries a reason.
    invalid-message(string),
    /// The message could not be enqueued for delivery. Carries a reason.
    spool-failed(string),
    /// Any other backend error.
    other(string),
  }
}

/// The `email` capability: submit a finished message for delivery through one of
/// the project's SMTP profiles. Deny-by-default (an ungranted guest has no binding
/// and `send` returns `access-denied`); the SMTP credentials live host-side and
/// are never exposed to the guest.
interface email-sender {
  use email-types.{email-message, email-error};

  /// Submit `message` for delivery. Returns once the message is **accepted for
  /// delivery** (spooled) — not once it is actually delivered.
  send: func(message: email-message) -> result<_, email-error>;
}

/// The email capability world (imported into request handlers / functions).
world email-host {
  import email-sender;
}

/// Value types for the `capability` capability: a guest **mints a fleet-signed target capability**
/// (PLAN-delegable-capabilities). The project attenuates a bounded slice of its OWN authority into a
/// signed bearer it can hand to a third party (an embed/share client). The token is bounded — its
/// audience is host-forced to the guest's own project (never redeemable elsewhere), its TTL is clamped
/// to the operator ceiling, and it carries an opaque, size-bounded app-context the host never
/// interprets — and its power is fully gated at redeem by the operator's target-eligible route config.
/// Deny-by-default: an ungranted guest (or posture-off) has no binding and `mint` returns
/// `access-denied`. The guest never sees the fleet signing key.
interface capability-types {
  /// A request to mint a target capability. The audience is NOT named here — the host forces it to
  /// the minting project.
  record mint-request {
    /// The target tenant `B` the capability grants access to (the app's tenant tag). Redeemable only
    /// within the minting project, over that project's own data.
    target-tenant: string,
    /// The public-subset name the capability is scoped to; must match a redeeming route's declared
    /// `public` (use the reserved tenant-only subset for a capability-only field).
    public-subset: string,
    /// Opaque, app-authored context (e.g. a per-client `sub`) carried with integrity and handed back
    /// to the resolver — the host never interprets it. Bounded by the host (entries + total bytes).
    app-context: list<tuple<string, string>>,
    /// Requested lifetime in seconds; the host clamps it to the operator's max.
    ttl-seconds: u64,
  }

  /// Why a mint failed.
  variant mint-error {
    /// The `capability` capability was not granted, or the `allow_guest_mint_capability` posture is
    /// off (deny-by-default).
    access-denied,
    /// The request was malformed (empty tenant/subset, a zero TTL, or an over-bounded app-context).
    invalid-request(string),
    /// The host failed to sign the token.
    failed(string),
  }
}

/// The `capability` capability: mint a fleet-signed target capability redeemable only at this guest's
/// OWN project. The returned string is the encoded token (an opaque bearer to hand to a client).
interface capability-minter {
  use capability-types.{mint-request, mint-error};

  /// Mint a bounded, fleet-signed target capability. The audience is host-forced to this project; the
  /// TTL is clamped to the operator ceiling; the app-context is size-bounded.
  mint: func(request: mint-request) -> result<string, mint-error>;
}

/// The capability-minting world (imported into request handlers / functions).
world capability-host {
  import capability-minter;
}

/// Value types for the `admin` capability: a guest **reconfigures its own project** (add a
/// domain, set an SMTP profile, write site config, write a secret) without a boatramp token.
/// The grant is conferred at deploy time (per-surface `admin:<surface>` import + the operator's
/// posture), intrinsically scoped to the guest's OWN project (host-stamped), and strictly less
/// than a project-admin token: no cross-project reach, no critical/node ops. Deny-by-default:
/// an ungranted verb (or a posture-off surface) returns `access-denied`.
interface admin-types {
  /// A pending domain-ownership challenge the guest must satisfy before `domain-verify`.
  record domain-challenge {
    host: string,
    method: string,       // "http" | "dns"
    /// The token to publish at the challenge location (`/.well-known/…` for http, a TXT record
    /// for dns). The host verifies it with a real network probe on `domain-verify`.
    token: string,
  }

  /// A create-or-update to an SMTP profile (partial: an unset field keeps the stored value,
  /// mirroring the admin API's merge semantics). The password is sealed host-side.
  record email-profile {
    host: option<string>,
    port: option<u16>,
    security: option<string>,   // "starttls" | "tls" | "plaintext"
    username: option<string>,
    password: option<string>,
    %from: option<string>,
    durable: option<bool>,
    /// Drop username + password (an unauthenticated relay).
    clear-auth: bool,
  }

  /// Why an admin operation was refused.
  variant admin-error {
    /// The capability, or this specific surface, was not granted (or the operator posture
    /// disables it).
    access-denied,
    /// The input was rejected (bad name/config/serialized-config).
    invalid-input(string),
    /// A domain attach was attempted before its ownership was proven.
    not-verified(string),
    /// The named resource does not exist.
    not-found(string),
    /// The per-project admin rate quota was exceeded.
    rate-limited,
    /// Any other backend error.
    other(string),
  }
}

/// The `admin` capability: per-surface project self-configuration. Each verb is gated on its
/// surface grant (`admin:domains` / `:email` / `:site` / `:secrets`); every mutation is
/// rate-limited per project and audited. Reads return **redacted** views only (never a
/// password/secret value).
interface admin {
  use admin-types.{domain-challenge, email-profile, admin-error};

  // --- admin:domains --- (site-scoped: `site` must be one of the guest's own project's sites)
  /// Begin verifying ownership of `host` for `site` (`method` = "http" | "dns"); returns the
  /// challenge to publish. Does not attach — call `domain-verify` after publishing the token.
  domain-add: func(site: string, host: string, method: string) -> result<domain-challenge, admin-error>;
  /// Run the real ownership probe for `host` on `site`; on success mark it verified + attach it
  /// so routing serves it. `ok(true)` = verified+attached, `ok(false)` = not proven yet.
  domain-verify: func(site: string, host: string) -> result<bool, admin-error>;
  /// Detach `host` from `site` (destructive; the site stops serving it).
  domain-remove: func(site: string, host: string) -> result<_, admin-error>;
  /// List `site`'s attached/verifying domains.
  domain-list: func(site: string) -> result<list<string>, admin-error>;

  // --- admin:email ---
  /// Create-or-merge the SMTP profile `name` (unset fields keep the stored value; a supplied
  /// password is sealed host-side and never returned).
  email-set: func(name: string, profile: email-profile) -> result<_, admin-error>;
  /// Delete the SMTP profile `name` (destructive).
  email-delete: func(name: string) -> result<_, admin-error>;
  /// List the project's SMTP profile names (redacted — no config/password).
  email-list: func() -> result<list<string>, admin-error>;

  // --- admin:site ---
  /// The site's current config as a JSON string (the `SiteConfig` wire form).
  site-config-get: func(site: string) -> result<string, admin-error>;
  /// Replace the site's config with `config` (a JSON `SiteConfig`). A newly-referenced domain
  /// must already be verified (the guest can't attach an unverified domain via a config write),
  /// and any `allow_imports` entry must be a known capability name.
  site-config-put: func(site: string, config: string) -> result<_, admin-error>;

  // --- admin:secrets (write-only; never reads a value back) ---
  /// Set/rotate the sealed secret `name` (the value is sealed host-side; there is no read).
  secret-set: func(name: string, value: string) -> result<_, admin-error>;
  /// Delete the sealed secret `name` (destructive).
  secret-delete: func(name: string) -> result<_, admin-error>;
  /// List the project's secret names (never values).
  secret-list: func() -> result<list<string>, admin-error>;
}

/// The admin capability world (imported into request handlers / functions).
world admin-host {
  import admin;
}

/// The `wasi:logging` capability world. A guest that imports `wasi:logging/logging`
/// gets its structured `log(level, context, message)` messages captured into the same
/// host sink as stdout/stderr, with the level preserved. Like stdio capture (and unlike
/// the grantable capabilities) this is host-side observability, not a deny-by-default grant.
world wasi-logging-host {
  import wasi:logging/logging;
}

/// Value types for the duplex, resumable **session** capability (`PLAN-session-primitive`): a
/// long-lived, client-addressable, bidirectional channel whose lifetime, ordering, backpressure,
/// and resume the host owns. Every frame is **opaque bytes** — the host never parses one.
interface session-types {
  /// A monotonic per-session outbound cursor (host-assigned). `0` = before the first frame.
  type cursor = u64;

  /// Why a session operation failed.
  variant session-error {
    /// The `session` capability was not granted to this component.
    access-denied,
    /// The frame exceeded the host's per-frame byte cap.
    frame-too-large,
    /// The unacked outbound buffer is full — backpressure; retry after the client acks.
    buffer-full,
    /// The session is closed.
    closed,
    /// Any other backend error.
    other(string),
  }

  /// The batch handed to one re-entry of the handler (mechanism B): the session id, the last
  /// checkpoint to resume from (if any), and the pending inbound frames in order. The host holds
  /// the session state between re-entries; the guest rehydrates from `resumed` (it must NOT rely on
  /// in-memory state surviving across re-entries — only a `checkpoint` survives).
  record session-input {
    id: string,
    resumed: option<list<u8>>,
    frames: list<list<u8>>,
  }
}

/// The host half a session handler imports: enqueue an outbound frame, set a resumable checkpoint,
/// and close. All operate on the **current** session, bound host-side at open — the guest names no
/// id and cannot address another session (cross-session/cross-tenant reach is structurally absent).
interface session {
  use session-types.{cursor, session-error};

  /// Enqueue an outbound frame (host → client). Ordered; the host assigns + returns its cursor and
  /// retains it for at-least-once redelivery until the client acks.
  send: func(payload: list<u8>) -> result<cursor, session-error>;

  /// Set the resumable snapshot (host persists it; replayed as `session-input.resumed` on the next
  /// re-entry). Opaque app state — the host never parses it.
  checkpoint: func(snapshot: list<u8>) -> result<_, session-error>;

  /// End the session with a reason; the client is notified and no further frames flow.
  close: func(reason: string) -> result<_, session-error>;
}

/// The handler half: the host calls `handle` once per re-entry with the pending inbound batch. `ok`
/// commits the invocation's `send`s + `checkpoint`; `err`/trap fails the re-entry (the inbound
/// frames are redelivered per the host's at-least-once semantics).
interface session-handler {
  use session-types.{session-input, session-error};

  /// Process one re-entry's inbound batch (rehydrate from `input.resumed`, `send`/`checkpoint` as
  /// needed). `ok` commits; `err`/trap redelivers.
  handle: func(input: session-input) -> result<_, session-error>;
}

/// A session component: it imports the session host half and must export the handler (like a
/// messaging `consumer`). Gated by the host `session` capability + the manifest `requires`. The
/// host `bindgen!`s this for the export caller (invoking `session-handler.handle`).
world session-host {
  import session;
  export session-handler;
}

/// Import-only world for the host `session` binding (the `SessionHost`/`SessionController` Host
/// impl), mirroring `admin-host` — generates just the `session` import Host trait, no export
/// machinery. (The full `session-host` world above is what the engine `bindgen!`s for dispatch.)
world session-import-host {
  import session;
}
