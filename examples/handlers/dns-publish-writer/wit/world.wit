// Combined guest world: a wasi:http handler that also imports the boatramp
// `dns-publish` capability, so it can WRITE DNS records through the host-held
// provider credential (the guest never holds a zone-write token). Built to a
// component with `cargo build --release --target wasm32-wasip2`; consumed as a
// fixture by the boatramp engine tests to exercise the dns-publish gate end to
// end (cap-req #24 WS3 live gate).
package boatramp:caps-example;

world handler {
  include wasi:http/proxy@0.2.0;
  import boatramp:handlers/dns-publish;
}
