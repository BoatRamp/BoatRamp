// The boatramp `session` capability interfaces, vendored for the guest (mailroom cap-req #22). These
// MUST match the host's definitions in boatramp-handlers (crates/boatramp-handlers/wit/world.wit)
// exactly so the component links against the engine's binding — including the `promote-connection`
// escalation func + its `promote-tls`/`promote-error` types.
package boatramp:handlers;

interface session-types {
  /// A monotonic per-session outbound cursor (host-assigned). `0` = before the first frame.
  type cursor = u64;

  /// Why a session operation failed.
  variant session-error {
    access-denied,
    frame-too-large,
    buffer-full,
    closed,
    other(string),
  }

  /// The batch handed to one re-entry of the handler (mechanism B).
  record session-input {
    id: string,
    resumed: option<list<u8>>,
    frames: list<list<u8>>,
  }

  /// How the host terminates TLS to a `promote-connection` upstream.
  enum promote-tls {
    plaintext,
    implicit-tls,
  }

  /// Why `promote-connection` failed (gate refusals are undifferentiated `not-authorized`).
  variant promote-error {
    not-authorized,
    upstream-unreachable(string),
    not-promotable,
    capacity,
    preamble-too-large,
    other(string),
  }
}

interface session {
  use session-types.{cursor, session-error, promote-tls, promote-error};

  send: func(payload: list<u8>) -> result<cursor, session-error>;
  checkpoint: func(snapshot: list<u8>) -> result<_, session-error>;
  close: func(reason: string) -> result<_, session-error>;

  /// Escalate this socket session connection to a persistent duplex splice to a guest-named
  /// upstream, dialed through the SAME egress/connect gate as `tcp-egress` (post-auth only).
  promote-connection: func(
    host: string,
    port: u16,
    tls: promote-tls,
    sni: option<string>,
    preamble: list<u8>,
  ) -> result<_, promote-error>;
}

interface session-handler {
  use session-types.{session-input, session-error};

  handle: func(input: session-input) -> result<_, session-error>;
}
