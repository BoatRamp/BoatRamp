// Example WebAssembly *session* guest world (mailroom cap-req #22 — session→connection escalation):
// imports the boatramp `session` host half (now including `promote-connection`) and exports the
// `session-handler` the engine re-enters once per inbound batch, like `session-greet`/`session-echo`.
// Unlike those, this guest can ESCALATE: after greeting + reading a `BRIDGE <host> <port>` command it
// calls `session::promote-connection` to splice the connection to the named upstream for its whole
// life (the transparent imap-proxy bridge). Built to a component with
// `cargo build --release --target wasm32-wasip2`; consumed as a fixture by the session-listener
// live-capability gate proving the promote mechanism end to end. Excluded from the workspace.
package boatramp:caps-example;

world session-imap-bridge {
  import boatramp:handlers/session;
  export boatramp:handlers/session-handler;
}
