// Combined guest world: a wasi:http handler that also imports the boatramp `graphql`
// capability, so it can run a GraphQL operation against the project's composed supergraph
// in-process. Built to a component with `cargo build --release --target wasm32-wasip2`;
// consumed as a fixture by the boatramp engine tests to exercise the graphql binding end to end.
package boatramp:caps-example;

world handler {
  include wasi:http/proxy@0.2.0;
  import boatramp:handlers/graphql;
}
