// Guest world for a GraphQL federation subgraph fixture: a plain wasi:http handler
// with no boatramp capabilities (it neither invokes siblings nor uses kv/sql). Built to
// a component with `cargo build --release --target wasm32-wasip2`; consumed by the
// boatramp-server federation end-to-end conformance test.
package boatramp:caps-example;

world handler {
  include wasi:http/proxy@0.2.0;
}
