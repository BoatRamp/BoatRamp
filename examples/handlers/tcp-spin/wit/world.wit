// Example WebAssembly *inbound-TCP connection* guest world (PLAN-handler-tcp-inbound) — the
// COMPUTE-BOUND fixture. Same shape as tcp-echo (imports only `wasi:io/streams`, exports the boatramp
// `tcp-connection-handler`), but the handler busy-loops forever with no suspending host call. Built
// with `cargo build --release --target wasm32-wasip2`; consumed as a fixture by the inbound-TCP live
// gate to prove the conn-lane epoch-yield lets the host watchdog preempt a non-yielding guest.
package boatramp:caps-example;

world tcp-spin {
  import wasi:io/streams@0.2.3;
  export boatramp:handlers/tcp-connection-handler;
}
