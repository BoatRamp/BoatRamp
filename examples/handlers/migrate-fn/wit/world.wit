// Guest world for a boatramp MIGRATION FUNCTION step: a wasi:http handler that imports BOTH the
// owner-role `migrate-ddl` capability AND the tenant `sql` capability. Importing both is deliberate
// — it proves the binding-split (Security S1): invoked as a migration step, `migrate-ddl` is granted
// but the tenant `sql` binding is ABSENT; invoked as a normal request, `migrate-ddl` returns
// `not-a-migration` (Security S2). Built with `cargo build --release --target wasm32-wasip2`;
// consumed as a fixture by the migrate function-step live gate.
package boatramp:caps-example;

world handler {
  include wasi:http/proxy@0.2.0;
  import boatramp:handlers/migrate-ddl;
  import boatramp:handlers/sql-query;
}
