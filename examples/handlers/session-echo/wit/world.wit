// Example WebAssembly *session* guest world: imports the boatramp `session` host
// half and exports the `session-handler` the engine re-enters once per inbound
// frame batch (mechanism B). Built to a component with
// `cargo build --release --target wasm32-wasip2`; consumed as a fixture by the
// session live-capability gate exercising the duplex + resume + close contract.
package boatramp:caps-example;

world session {
  import boatramp:handlers/session;
  export boatramp:handlers/session-handler;
}
