# Minimum test count for the per-push `test-server-features` CI lane
# (`cargo test -p boatramp-server --features handlers,oidc,mcp,compression,domain-verify-dns`).
#
# The tripwire: the lane fails if the live `--list` count drops BELOW this number. A
# feature-gate typo (or a `#[cfg]` mistake) that silently drops a whole test module is
# exactly how 59 handlers-gated tests once ran nowhere — a shrinking count is a Mode-D
# regression, and this catches it at the merge gate. Adding tests only ever raises the
# floor; bump this number deliberately when you do (never lower it to make CI pass).
SERVER_FEATURES_MIN=325
